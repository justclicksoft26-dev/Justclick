# Copy to ../.env (repo root) and fill in. Never commit the real file.
Schema=ORACLE_USER
Password=ORACLE_PASSWORD
CONNECTION_STRING=host:1521/service_name
PORT=5000
# Shared secret between the server and every agent (long, random).
AGENT_API_KEY=
# Login tokens: set a fixed value so sessions survive a server restart.
JWT_SECRET=

# per-branch app users (server/src/setup-users.js)
BRANCH1_USER=
BRANCH1_PASS=
BRANCH2_USER=
BRANCH2_PASS=

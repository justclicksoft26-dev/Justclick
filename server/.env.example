# Copy to ../.env (repo root) and fill in. Never commit the real file.
Schema=ORACLE_USER
Password=ORACLE_PASSWORD
CONNECTION_STRING=host:1521/service_name
PORT=5000
# Shared secret between the server and every agent (long, random).
AGENT_API_KEY=
# Login tokens: set a fixed value so sessions survive a server restart.
JWT_SECRET=
# Optional: SHIFT_ID (from SHIFT_SETUP) used when posting actual times for an employee who has no shift on
# some day, instead of skipping that employee. The shift is only borrowed during the posting; SHIFT_EMP is not changed.
DEFAULT_SHIFT_ID=

{
  "name": "attendance-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/agent.js",
    "once": "node --disable-warning=ExperimentalWarning src/agent.js --once",
    "probe": "node --disable-warning=ExperimentalWarning src/probe.js",
    "dump": "node --disable-warning=ExperimentalWarning src/dump.js",
    "service:install": "node src/service.js install",
    "service:uninstall": "node src/service.js uninstall",
    "test": "node --test"
  },
  "engines": { "node": ">=22.5" },
  "dependencies": {
    "node-windows": "^1.0.0-beta.8",
    "node-zklib": "^1.3.0"
  }
}
